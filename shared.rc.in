#include <winres.h>

1 VERSIONINFO
PRODUCTVERSION @RC_VER_MAJ@,@RC_VER_MIN@,@RC_VER_PAT@,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName",      "YourSoftware Foundation"
            VALUE "FileDescription",  "@RC_FILE_DESCRIPTION@"
            VALUE "LegalCopyright",   "\xa9 2026 YourSoftware Foundation Ltd."
            VALUE "ProductName",      "@RC_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@RC_VER_MAJ@.@RC_VER_MIN@.@RC_VER_PAT@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END