#include <winres.h>

1 VERSIONINFO
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "YourSoftware Foundation LTD"
            VALUE "FileDescription",  "A part of the YourSound suite."
            VALUE "LegalCopyright",   "Copyright (C) 2026 YourSoftware Foundation"
            VALUE "ProductName",      "YourSound"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END